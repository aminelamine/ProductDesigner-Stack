# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bridge DS — knowledge base data (regenerated via /design-workflow setup)
.claude/skills/design-workflow/references/knowledge-base/registries/*.json
.claude/skills/design-workflow/references/knowledge-base/ui-references/screenshots/*.png
.claude/skills/design-workflow/references/knowledge-base/ui-references/screenshots/*.jpg

# MCP config — contient le token Figma, ne jamais commiter
.mcp.json

# Template agent-stack — a son propre repo GitHub séparé
agent-stack-template/

# Dossiers de migration / nettoyage filesystem (non-deletable sur mount macOS)
.specs-migrated/
.skills-migrated/
.cleanup-temp/
CLAUDE.md.bak
.claude/settings.local.json
