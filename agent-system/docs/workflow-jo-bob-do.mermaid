%%{init: {'theme': 'dark', 'themeVariables': {'primaryColor': '#1e293b', 'primaryTextColor': '#e2e8f0', 'primaryBorderColor': '#475569', 'lineColor': '#64748b', 'secondaryColor': '#0f172a', 'tertiaryColor': '#1a1a2e'}}}%%

flowchart TD

    %% ── Styles ──────────────────────────────────────────────────
    classDef agentJO     fill:#1e1b4b,stroke:#818cf8,color:#c7d2fe,font-weight:bold
    classDef agentDS     fill:#1a2e1a,stroke:#4ade80,color:#bbf7d0,font-weight:bold
    classDef agentBOB    fill:#1c1917,stroke:#fb923c,color:#fed7aa,font-weight:bold
    classDef agentDO     fill:#1e1b2e,stroke:#c084fc,color:#e9d5ff,font-weight:bold
    classDef gate        fill:#1c1917,stroke:#f59e0b,color:#fcd34d,font-weight:bold
    classDef gateShip    fill:#0c1a0c,stroke:#16a34a,color:#4ade80,font-weight:bold
    classDef output      fill:#052e16,stroke:#16a34a,color:#86efac
    classDef rejected    fill:#2d0a0a,stroke:#ef4444,color:#fca5a5
    classDef rework      fill:#1c1209,stroke:#d97706,color:#fcd34d
    classDef start       fill:#0f172a,stroke:#94a3b8,color:#f1f5f9,font-weight:bold

    %% ── Entrée ──────────────────────────────────────────────────
    START(["💡 Idée brute"]):::start

    %% ═════════════════════════════════════════════════════
    %% PHASE 1 — PLAN
    %% ═════════════════════════════════════════════════════
    subgraph PLAN ["  🟣  PHASE PLAN — JO, Architecte & Strategist"]
        direction TB
        JO1["🔍 Challenge l'idée\n━━━━━━━━━━━━━━━━━\n• Hypothèse produit\n• JTBD + contraintes\n• Risques & anti-patterns"]:::agentJO
        JO2["📄 Génère la spec\n━━━━━━━━━━━━━━━━━\nfeature_[ID].md\n→ specs/active/"]:::agentJO
        GATE_SPEC{"Talent\nvalide ?"}:::gate
        DROP[/"❌ specs/dropped/"/]:::rejected
    end

    START --> JO1
    JO1 --> JO2
    JO2 --> GATE_SPEC
    GATE_SPEC -- "🔁 Révision" --> JO1
    GATE_SPEC -- "Abandon" --> DROP

    %% ═════════════════════════════════════════════════════
    %% PHASE 2 — DESIGN (optionnel)
    %% ═════════════════════════════════════════════════════
    subgraph DESIGN ["  🟢  PHASE DESIGN — Bridge DS  ·  optionnel"]
        direction TB
        DS_CHECK{"Feature\nvisuelle ?"}:::gate
        DS1["📐 Lit la spec validée"]:::agentDS
        DS2["🎨 Génère le frame Figma\n→ design-workflow/"]:::agentDS
    end

    GATE_SPEC -- "✅ VALIDÉE TALENT" --> DS_CHECK
    DS_CHECK -- "Oui → /design-workflow" --> DS1
    DS1 --> DS2

    %% ═════════════════════════════════════════════════════
    %% PHASE 3 — SHIP
    %% ═════════════════════════════════════════════════════
    subgraph SHIP ["  🟠  PHASE SHIP — BOB, Builder & UI/UX"]
        direction TB
        BOB1["📚 Lit les inputs\n━━━━━━━━━━━━━━━━━\n• Spec validée\n• design_guide.md\n• Frame Figma (si dispo)"]:::agentBOB

        BOB2["✍️ Brief Esthétique\n━━━━━━━━━━━━━━━━━\n• Direction créative\n• Typographie\n• Palette & Tension\n• Composition spatiale"]:::agentBOB

        GATE_BRIEF{"⏸ Gate obligatoire\nTalent valide\nle brief ?"}:::gate

        subgraph RALPH ["  🔄  Ralph Loop — 6 étapes"]
            direction LR
            R1["📍 1 / 6\nStructure"]:::agentBOB
            R2["📍 2 / 6\nScaffold"]:::agentBOB
            R3["📍 3 / 6\nCore Logic"]:::agentBOB
            R4["📍 4 / 6\nUI"]:::agentBOB
            R5["📍 5 / 6\nÉtats"]:::agentBOB
            R6["📍 6 / 6\nPolish"]:::agentBOB
        end

        CODE[/"✅ Code livré"/]:::output
    end

    DS_CHECK -- "Non" --> BOB1
    DS2 --> BOB1
    BOB1 --> BOB2
    BOB2 --> GATE_BRIEF
    GATE_BRIEF -- "🔁 Ajuster" --> BOB2
    GATE_BRIEF -- "✅ ok" --> R1
    R1 --> R2 --> R3 --> R4 --> R5 --> R6 --> CODE

    %% ═════════════════════════════════════════════════════
    %% PHASE 4 — ANALYZE
    %% ═════════════════════════════════════════════════════
    subgraph ANALYZE ["  🟣  PHASE ANALYZE — DO, Product QA & CX"]
        direction TB
        DO1["🔬 Évalue le livrable\n━━━━━━━━━━━━━━━━━\n• Conformité spec\n• Qualité UX\n• Qualité code\n• Edge cases"]:::agentDO
        DO2["📊 Verdict /20\n+ Feedbacks structurés"]:::agentDO
        GATE_SCORE{"Score ≥ 18 / 20 ?"}:::gateShip
        SHIPPED[/"🚀 specs/shipped/\nFeature validée"/]:::output
        REWORK["🔁 Rework demandé\n→ feedbacks → BOB"]:::rework
    end

    CODE --> DO1
    DO1 --> DO2
    DO2 --> GATE_SCORE
    GATE_SCORE -- "✅ Validée" --> SHIPPED
    GATE_SCORE -- "❌ < 18" --> REWORK
    REWORK -- "Retour itération" --> BOB1
